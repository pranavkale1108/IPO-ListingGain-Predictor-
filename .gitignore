# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Model artifacts and serialized weights
*.pkl
*.joblib
models/*
!models/.gitkeep

# Environment variables & secrets
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo
.codeatlas/

# Ensure data folders remain tracked via .gitkeep
!data/
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep
!reports/
!reports/figures/
!reports/figures/.gitkeep
!app/.gitkeep
!notebooks/.gitkeep
